# Copy to .env and fill in. Never commit .env.

# --- Runtime ---
APP_ENV=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000

# --- Web app (public, compiled into the browser bundle) ---
# Where the browser reaches the API; Compose passes this as PUBLIC_API_BASE_URL.
PUBLIC_API_BASE_URL=http://localhost:8000

# --- Backend services (values used when running the API outside Docker) ---
DATABASE_URL=postgresql+asyncpg://smartroute:smartroute@localhost:5432/smartroute
REDIS_URL=redis://localhost:6379/0
OTP_BASE_URL=http://localhost:8080
OTP_GRAPH_VERSION_FILE=data/otp/graph/graph-version
GTFS_MANIFEST_FILE=data/otp/graph/manifest.json
# Secret for hashing cache and rate-limit keys. Required in production:
#   python -c "import secrets; print(secrets.token_hex(32))"
KEY_HASHING_SECRET=

# --- Docker Compose PostgreSQL credentials (local development only) ---
POSTGRES_USER=smartroute
POSTGRES_PASSWORD=smartroute
POSTGRES_DB=smartroute

# --- Claude (server-side only) ---
# With a key, Claude interprets typed preferences, words route explanations and
# proposes transfers. Without one, the app runs on deterministic rules.
ANTHROPIC_API_KEY=
# auto (Claude when a key is set) | anthropic | baseline | disabled
LLM_PROVIDER=auto
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
LLM_DAILY_CALL_LIMIT=2000

# Background search for faster transfers after each route search
SUGGESTIONS_ENABLED=true

# --- Transit data sources (public feeds; no API keys needed) ---
PATH_GTFS_RT_URL=https://path.transitdata.nyc/gtfsrt

# Address search (OpenStreetMap via Photon). Empty disables it; stations still work.
PHOTON_BASE_URL=https://photon.komoot.io

# --- Dashboards (./start.sh --with-dashboards; local use only) ---
GRAFANA_ADMIN_PASSWORD=admin
