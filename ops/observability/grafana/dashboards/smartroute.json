        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      },
      "description": "Time since the worker last fetched MTA elevator status. Status older than 20 minutes is shown to riders as stale."
    },
