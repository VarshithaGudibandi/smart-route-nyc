      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(srn_route_searches_total{cache=~\"hit|shared\"}[5m])) / clamp_min(sum(rate(srn_route_searches_total[5m])), 1e-9)",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value"
      },
      "description": "Searches answered from the cache or by joining an identical search already in flight."
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Investigations pending",
      "datasource": {
        "type": "prometheus",
