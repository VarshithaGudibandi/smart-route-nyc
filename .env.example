# Copy to .env and fill in. Never commit .env.

# --- Runtime ---
APP_ENV=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000

# --- Frontend (public, browser-visible; restrict the token to allowed URLs) ---
NEXT_PUBLIC_MAPBOX_TOKEN=
BACKEND_BASE_URL=http://localhost:8000

# --- Backend services ---
DATABASE_URL=postgresql+asyncpg://smartroute:smartroute@localhost:5432/smartroute
REDIS_URL=redis://localhost:6379/0
OTP_GRAPHQL_URL=http://localhost:8080/otp/gtfs/v1

# --- LLM provider (server-side only) ---
LLM_API_KEY=
LLM_MODEL=

# --- Transit data sources ---
MTA_API_KEY=
PATH_API_BASE_URL=
PATH_GTFS_RT_URL=
