{"id": "basic-04", "category": "basic", "text": "Just get me there, no special needs", "expected": {"step_free_required": false, "wheelchair_required": false}}
{"id": "basic-05", "category": "basic", "text": "I'm running late, quickest route", "expected": {"primary": "FASTEST"}}
